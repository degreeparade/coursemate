# Copy to .env and edit. All optional.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_BACKEND=auto            # auto | ollama | extractive | hf
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
# MIN_SIMILARITY=0.28       # refusal threshold (tune with the Evaluation tab)
